	"type": "module",
	"imports": {},
	"scripts": {
		"build": "rolldown -c",
		"dev": "tsx watch apps/api/src/server.ts",
		"start": "NODE_ENV=production node dist/server.js",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check ."
	},
	"dependencies": {
		"fastify": "^5.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"rolldown": "^1.2.14",
		"tsx": "^4.20.0",
		"typescript": "^7.0.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=12",
			"onFail": "warn"
		}
	}
}
